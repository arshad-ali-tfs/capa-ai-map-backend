# Copy to .env.docker; Docker env files use plain KEY=value, without shell quotes.
# All paths are Linux paths INSIDE the container, not Windows host paths.
CAPA_ENV=local
CAPA_PROJECT_ROOT=/app
CAPA_DATA_DIR=/data
CAPA_CACHE_DIR=/data/cache
# Set this to the actual imported snapshot filename before using source features.
CAPA_SOURCE_SNAPSHOT=
CAPA_SOURCE_CSV=/data/sources/trackwise_records.csv
MAP_HOST=0.0.0.0
MAP_PORT=8101
MAP_CORS_ORIGINS=["http://localhost:8100","http://127.0.0.1:8100","http://localhost:5173","http://127.0.0.1:5173"]
MAP_ASSETS_DIR=/data/assets
HF_HOME=/data/models/huggingface
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
OPENAI_MODEL=gpt-6.1-sol
OPENAI_REASONING_EFFORT=medium
OPENAI_BASE_URL=
OPENAI_API_KEY=
MAP_DASHBOARD_RUN_ID=
